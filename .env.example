# Copy this file to .env.local and fill in both values to turn on Google sign-in.
# On Vercel, add the same two names under Settings → Environment Variables.

# Where the .NET API runs (no slash at the end)
VITE_API_URL=http://localhost:5045

# Your Google OAuth client ID (Google Cloud Console → APIs & Services → Credentials)
VITE_GOOGLE_CLIENT_ID=
